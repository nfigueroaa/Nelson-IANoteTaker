# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# Google Cloud Speech-to-Text
# Modelo: latest_long (reuniones largas), telephony (llamadas), latest_short (< 1 min)
STT_MODEL=latest_long
# Enhanced cuesta ~50% más que Standard. Dejar en false para desarrollo/testing.
# Cambiar a true solo si necesitas mayor precisión en producción.
STT_ENHANCED=false
