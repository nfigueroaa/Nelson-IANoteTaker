{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "composite": true,
    "resolveJsonModule": true,
    "paths": {
      "@nelson/shared-types": ["../../packages/shared-types/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/shared-types/src"],
  "exclude": ["node_modules", "dist"]
}
